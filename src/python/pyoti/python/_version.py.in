"""
Version information for the pyoti package.

This file is GENERATED by CMake from ``src/python/pyoti/python/_version.py.in``. The root ``VERSION``
file is the single source of truth for the C, Fortran, Python and conda versions alike, so this
module must never be edited by hand and the version must never be hardcoded elsewhere.
"""

__all__ = ["__version__", "__version_info__", "version_number"]

#: Full package version as a ``"MAJOR.MINOR.PATCH"`` string.
__version__ = "@OTI_VERSION@"

#: Version components as an integer tuple, suitable for direct comparison.
__version_info__ = (@OTI_VERSION_MAJOR@, @OTI_VERSION_MINOR@, @OTI_VERSION_PATCH@)


#*****************************************************************************************************
def version_number():
    """
    Returns the package version packed into a single monotonically increasing integer.

    The packing matches the C ``OTI_VERSION_ENCODE()`` macro and the Fortran
    ``OTI_VERSION_NUMBER`` parameter, so the three bindings can be compared directly.

    Returns
    -------
    int
        The value ``major * 10000 + minor * 100 + patch``.

    Examples
    --------
    >>> from pyoti import version_number
    >>> version_number() >= 10100
    True
    """

    major, minor, patch = __version_info__

    return major * 10000 + minor * 100 + patch

# end function

