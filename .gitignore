*~

# pdf files generated should not be committed.
*.pdf

# Root data folder
data/
build/
build*/

# VSCode garbage
.vscode*

# MacOS trash
.DS_Store

# Python trash
__pycache__/

# Cython generated modules.
src/python/pyoti/cython/*.c
src/python/pyoti/cython/static/*.c
src/python/pyoti/cython/*.h
src/python/pyoti/cython/static/*.h

# test jupyter notebooks
tests/jupyter_notebook/*

# Fortran module build artifacts
*.mod

# Version artifacts generated by CMake from the root VERSION file. These normally land in build/
# (already ignored above); the entries below guard against in-source configure runs.
include/oti/version.h
src/fortran/core/oti_version.f90
src/python/pyoti/python/_version.py
