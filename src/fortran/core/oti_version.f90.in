!*******************************************************************************************************!
!> @brief This module exposes the OTIlib version to Fortran callers.
!!
!! This file is GENERATED by CMake from src/fortran/core/oti_version.f90.in. The root VERSION file is
!! the single source of truth; never hardcode the version here or in any other source file.
!!
!! The module deliberately declares PARAMETERs only (no procedures, no module variables). Because the
!! static and sparse Fortran families are compiled into separate libraries that end up linked into the
!! same binary, a procedure declared here would be emitted twice and collide at link time; PARAMETERs
!! emit no symbols and can therefore be safely compiled into both.
!!
!! @author Mauricio Aristizabal Cano, University of Texas at San Antonio
!*******************************************************************************************************!
MODULE oti_version
   !----------------------------------------------------------------------------------------------------!
   IMPLICIT NONE
   !----------------------------------------------------------------------------------------------------!
   !> Full OTIlib version as a "MAJOR.MINOR.PATCH" string. Named after the C macro rather than
   !! plain OTI_VERSION because Fortran forbids an entity sharing the name of its own module.
   CHARACTER(LEN=*), PARAMETER :: OTI_VERSION_STRING = "@OTI_VERSION@"
   !----------------------------------------------------------------------------------------------------!
   !> Major component of the OTIlib version (breaking changes).
   INTEGER, PARAMETER          :: OTI_VERSION_MAJOR  = @OTI_VERSION_MAJOR@
   !> Minor component of the OTIlib version (backwards-compatible additions).
   INTEGER, PARAMETER          :: OTI_VERSION_MINOR  = @OTI_VERSION_MINOR@
   !> Patch component of the OTIlib version (backwards-compatible fixes).
   INTEGER, PARAMETER          :: OTI_VERSION_PATCH  = @OTI_VERSION_PATCH@
   !----------------------------------------------------------------------------------------------------!
   !> Version packed into a single monotonically increasing integer, matching the C
   !! OTI_VERSION_ENCODE() macro, so that IF (OTI_VERSION_NUMBER >= 10100) guards can be written.
   INTEGER, PARAMETER          :: OTI_VERSION_NUMBER = OTI_VERSION_MAJOR * 10000 &
                                                     + OTI_VERSION_MINOR * 100   &
                                                     + OTI_VERSION_PATCH
   !----------------------------------------------------------------------------------------------------!
END MODULE oti_version
!-------------------------------------------------------------------------------------------------------!
