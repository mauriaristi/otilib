#ifndef OTI_VERSION_H
#define OTI_VERSION_H

// ----------------------------------------------------------------------------------------------------
// -----------------------------------     LIBRARY VERSION      ---------------------------------------
//
// This file is GENERATED by CMake from include/oti/version.h.in. Do not edit the generated copy in the
// build tree, and do not hardcode the version anywhere else: the root VERSION file is the single
// source of truth for every language binding (C, Fortran, Python) and for the conda recipe.
// ----------------------------------------------------------------------------------------------------

/** @brief Major component of the OTIlib version (breaking changes). */
#define OTI_VERSION_MAJOR @OTI_VERSION_MAJOR@

/** @brief Minor component of the OTIlib version (backwards-compatible additions). */
#define OTI_VERSION_MINOR @OTI_VERSION_MINOR@

/** @brief Patch component of the OTIlib version (backwards-compatible fixes). */
#define OTI_VERSION_PATCH @OTI_VERSION_PATCH@

/** @brief Full OTIlib version as a "MAJOR.MINOR.PATCH" string literal. */
#define OTI_VERSION_STRING "@OTI_VERSION@"

/**
 * @brief Packs a MAJOR.MINOR.PATCH triplet into a single monotonically increasing integer.
 *
 * Intended for compile-time feature guards, e.g.
 * @code
 * #if OTI_VERSION_NUMBER >= OTI_VERSION_ENCODE(1, 1, 0)
 * #endif
 * @endcode
 */
#define OTI_VERSION_ENCODE(major, minor, patch) ((major) * 10000 + (minor) * 100 + (patch))

/** @brief The current OTIlib version packed with OTI_VERSION_ENCODE(). */
#define OTI_VERSION_NUMBER \
    OTI_VERSION_ENCODE(OTI_VERSION_MAJOR, OTI_VERSION_MINOR, OTI_VERSION_PATCH)

#ifdef __cplusplus
extern "C" {
#endif

/**
 * @name Runtime version queries
 * The macros above report the version of the headers the caller compiled against. The functions
 * below report the version the linked library was itself built with, so that a header/library
 * mismatch can be detected at run time.
 * @{
 */

/**
 * @brief Returns the version of the linked OTIlib as a "MAJOR.MINOR.PATCH" string.
 *
 * @return Pointer to a static, NUL-terminated string owned by the library. The caller must not
 *         modify or free it.
 */
const char *oti_version(void);

/**
 * @brief Retrieves the numeric components of the linked OTIlib version.
 *
 * @param[out] major Receives the major component. May be NULL if not required.
 * @param[out] minor Receives the minor component. May be NULL if not required.
 * @param[out] patch Receives the patch component. May be NULL if not required.
 */
void oti_version_numbers(int *major, int *minor, int *patch);

/**
 * @brief Returns the linked OTIlib version packed with OTI_VERSION_ENCODE().
 *
 * @return Packed version number, comparable against OTI_VERSION_ENCODE(major, minor, patch).
 */
int oti_version_number(void);

/** @} */
// ------------------------------------------------------------------------------------------------------

#ifdef __cplusplus
}
#endif

// ----------------------------------------------------------------------------------------------------
// ---------------------------------      END LIBRARY VERSION      ------------------------------------
// ----------------------------------------------------------------------------------------------------

#endif
